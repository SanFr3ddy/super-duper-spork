# Cadena de conexión de Neon (Dashboard de Neon > Connection string, con el pooler)
DATABASE_URL=postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Puerto local. Render lo define automáticamente, no hace falta ponerlo ahí.
PORT=3000

# development | production
NODE_ENV=development

# Contraseña para entrar a la app. Si se deja vacía, la app queda abierta (solo recomendable en local).
APP_PASSWORD=

# Secreto para firmar la cookie de sesión (cualquier texto largo y aleatorio).
SESSION_SECRET=

# Moneda y formato de números (código ISO 4217 y locale BCP 47)
CURRENCY=MXN
LOCALE=es-MX

# Zona horaria para calcular "hoy", el mes actual y las fechas de corte/pago (Render usa UTC por defecto)
TZ=America/Mexico_City
